{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-dev",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "routes": [
    { "pattern": "chaka.dev", "custom_domain": true },
    { "pattern": "www.chaka.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
